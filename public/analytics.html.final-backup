<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>B2B Wholesale Pricing Fast — Analytics</title>

<style>
:root{
--bg:#f6f7f8;
--card:#fff;
--text:#202223;
--muted:#6d7175;
--border:#e1e3e5;
--primary:#008060;
--soft:#e7f5ef;
--danger:#d72c0d;
}

[data-theme="dark"]{
--bg:#101312;
--card:#181c1a;
--text:#f1f3f2;
--muted:#a6ada9;
--border:#303633;
--primary:#35b98a;
--soft:#17382d;
--danger:#ff8a75;
}

*{box-sizing:border-box}

body{
margin:0;
background:var(--bg);
color:var(--text);
font-family:Arial,sans-serif;
}

button,input,select{
font:inherit;
}

.header{
height:64px;
background:var(--card);
border-bottom:1px solid var(--border);
display:flex;
align-items:center;
justify-content:space-between;
padding:0 18px;
position:sticky;
top:0;
z-index:20;
}

.brand{
display:flex;
align-items:center;
gap:10px;
font-weight:700;
}

.logo{
width:36px;
height:36px;
border-radius:9px;
background:var(--primary);
color:#fff;
display:grid;
place-items:center;
font-weight:800;
}

.brand span{
color:var(--primary);
}

.right{
display:flex;
align-items:center;
gap:8px;
}

.icon{
width:38px;
height:38px;
border:0;
background:transparent;
color:var(--text);
border-radius:8px;
cursor:pointer;
}

.store{
border:1px solid var(--border);
background:var(--card);
color:var(--text);
border-radius:9px;
padding:4px 7px 4px 12px;
display:flex;
align-items:center;
gap:8px;
}

.avatar{
width:30px;
height:30px;
border-radius:8px;
background:var(--primary);
color:#fff;
display:grid;
place-items:center;
font-weight:bold;
}

.layout{
display:flex;
min-height:calc(100vh - 64px);
}

.sidebar{
width:230px;
background:var(--card);
border-right:1px solid var(--border);
position:fixed;
top:64px;
bottom:0;
padding:18px 12px;
}

.label{
font-size:10px;
font-weight:bold;
color:var(--muted);
letter-spacing:1px;
padding:12px 10px 7px;
}

.nav{
width:100%;
border:0;
background:transparent;
color:var(--muted);
text-align:left;
padding:10px;
border-radius:8px;
cursor:pointer;
margin-bottom:3px;
}

.nav:hover{
background:var(--bg);
color:var(--text);
}

.nav.active{
background:var(--soft);
color:var(--primary);
font-weight:bold;
}

.main{
margin-left:230px;
width:100%;
padding:28px;
}

.container{
max-width:1150px;
margin:auto;
}

.top{
display:flex;
justify-content:space-between;
align-items:end;
gap:20px;
margin-bottom:24px;
}

.eyebrow{
color:var(--primary);
font-size:10px;
font-weight:bold;
letter-spacing:1px;
margin-bottom:7px;
}

h1{
margin:0;
font-size:28px;
}

.subtitle{
margin-top:7px;
font-size:13px;
color:var(--muted);
}

.actions{
display:flex;
gap:8px;
}

.btn{
border:1px solid var(--border);
background:var(--card);
color:var(--text);
padding:10px 14px;
border-radius:8px;
cursor:pointer;
font-weight:bold;
}

.primary{
background:var(--primary);
border-color:var(--primary);
color:#fff;
}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:12px;
margin-bottom:18px;
}

.stat{
background:var(--card);
border:1px solid var(--border);
border-radius:11px;
padding:18px;
}

.stat-title{
font-size:12px;
color:var(--muted);
}

.stat-number{
font-size:25px;
font-weight:bold;
margin-top:8px;
}

.stat-change{
font-size:11px;
color:var(--primary);
margin-top:7px;
}

.grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:18px;
margin-bottom:18px;
}

.panel{
background:var(--card);
border:1px solid var(--border);
border-radius:11px;
overflow:hidden;
}

.panel-head{
padding:17px;
border-bottom:1px solid var(--border);
display:flex;
align-items:center;
justify-content:space-between;
}

.panel-title{
font-size:15px;
font-weight:bold;
}

.panel-subtitle{
font-size:11px;
color:var(--muted);
margin-top:4px;
}

.chart{
height:260px;
padding:20px;
display:flex;
align-items:flex-end;
gap:8px;
}

.bar-wrap{
height:100%;
flex:1;
display:flex;
flex-direction:column;
justify-content:flex-end;
align-items:center;
gap:7px;
}

.bar{
width:100%;
max-width:38px;
background:var(--primary);
border-radius:6px 6px 2px 2px;
min-height:4px;
}

.bar-label{
font-size:9px;
color:var(--muted);
}

.bar-value{
font-size:9px;
color:var(--text);
}

.table{
width:100%;
border-collapse:collapse;
}

.table th{
font-size:10px;
color:var(--muted);
text-align:left;
padding:12px 16px;
border-bottom:1px solid var(--border);
}

.table td{
font-size:12px;
padding:13px 16px;
border-bottom:1px solid var(--border);
}

.table tr:last-child td{
border-bottom:0;
}

.badge{
display:inline-block;
background:var(--soft);
color:var(--primary);
padding:5px 8px;
border-radius:20px;
font-size:10px;
font-weight:bold;
}

.empty{
padding:45px 20px;
text-align:center;
color:var(--muted);
font-size:13px;
}

.full{
margin-bottom:18px;
}

.loading{
padding:45px;
text-align:center;
color:var(--muted);
}

.error{
padding:25px;
text-align:center;
color:var(--danger);
}

.mobile{
display:none;
}

@media(max-width:950px){

.stats{
grid-template-columns:repeat(2,1fr);
}

.grid{
grid-template-columns:1fr;
}

}

@media(max-width:800px){

.sidebar{
display:none;
}

.main{
margin-left:0;
padding:22px 15px 80px;
}

.top{
display:block;
}

.actions{
margin-top:16px;
}

.actions .btn{
width:100%;
}

.stats{
grid-template-columns:1fr 1fr;
}

.mobile{
position:fixed;
bottom:0;
left:0;
right:0;
height:64px;
background:var(--card);
border-top:1px solid var(--border);
display:flex;
justify-content:space-around;
z-index:30;
}

.mobile button{
border:0;
background:transparent;
color:var(--muted);
font-size:10px;
}

.mobile .active{
color:var(--primary);
font-weight:bold;
}

}

@media(max-width:500px){

.brand{
font-size:12px;
}

.store span{
display:none;
}

.stats{
grid-template-columns:1fr;
}

.chart{
height:220px;
padding:15px;
gap:4px;
}

.table{
min-width:600px;
}

.table-wrap{
overflow-x:auto;
}

}
</style>
</head>

<body>

<header class="header">

<div class="brand">
<div class="logo">BF</div>
<div>B2B Wholesale Pricing <span>Fast</span></div>
</div>

<div class="right">

<button
class="icon"
id="themeButton"
onclick="toggleTheme()">☾</button>

<button class="icon">🔔</button>

<div class="store">
<span>My Store</span>
<div class="avatar">M</div>
</div>

</div>

</header>

<div class="layout">

<aside class="sidebar">

<div class="label">OVERVIEW</div>

<button class="nav" onclick="location.href='index.html'">
⌂ &nbsp; Dashboard
</button>

<div class="label">COMMERCE</div>

<button class="nav" onclick="location.href='index.html'">
◇ &nbsp; Pricing Rules
</button>

<button class="nav" onclick="location.href='customers.html'">
♙ &nbsp; Customer Groups
</button>

<button class="nav" onclick="location.href='products.html'">
▣ &nbsp; Products
</button>

<button class="nav" onclick="location.href='price-lists.html'">
▤ &nbsp; Price Lists
</button>

<div class="label">INSIGHTS</div>

<button class="nav active">
◒ &nbsp; Analytics
</button>

<div class="label">SYSTEM</div>

<button class="nav" onclick="location.href='settings.html'">
⚙ &nbsp; Settings
</button>

</aside>

<main class="main">

<div class="container">

<div class="top">

<div>

<div class="eyebrow">BUSINESS INTELLIGENCE</div>

<h1>Sales Analytics</h1>

<div class="subtitle">
Understand revenue, orders, customers and product performance.
</div>

</div>

<div class="actions">

<button class="btn" onclick="loadAnalytics()">
↻ Refresh
</button>

</div>

</div>

<div id="loading" class="loading">
Loading your sales data...
</div>

<div id="content" style="display:none">

<div class="stats">

<div class="stat">
<div class="stat-title">Total Revenue</div>
<div class="stat-number" id="revenue">₹0</div>
<div class="stat-change">All recorded sales</div>
</div>

<div class="stat">
<div class="stat-title">Total Orders</div>
<div class="stat-number" id="orders">0</div>
<div class="stat-change">Orders processed</div>
</div>

<div class="stat">
<div class="stat-title">Average Order Value</div>
<div class="stat-number" id="aov">₹0</div>
<div class="stat-change">Revenue per order</div>
</div>

<div class="stat">
<div class="stat-title">Customers</div>
<div class="stat-number" id="customers">0</div>
<div class="stat-change">Unique buyers</div>
</div>

</div>

<div class="grid">

<div class="panel">

<div class="panel-head">

<div>
<div class="panel-title">Revenue Overview</div>
<div class="panel-subtitle">
Sales performance
</div>
</div>

</div>

<div class="chart" id="revenueChart"></div>

</div>

<div class="panel">

<div class="panel-head">

<div>
<div class="panel-title">Order Overview</div>
<div class="panel-subtitle">
Order activity
</div>
</div>

</div>

<div class="chart" id="orderChart"></div>

</div>

</div>

<div class="panel full">

<div class="panel-head">

<div>
<div class="panel-title">Top Products</div>
<div class="panel-subtitle">
Products generating the most revenue
</div>
</div>

</div>

<div class="table-wrap">

<table class="table">

<thead>

<tr>
<th>Product</th>
<th>Units</th>
<th>Orders</th>
<th>Revenue</th>
</tr>

</thead>

<tbody id="productsTable"></tbody>

</table>

</div>

</div>

<div class="panel full">

<div class="panel-head">

<div>
<div class="panel-title">Recent Orders</div>
<div class="panel-subtitle">
Latest recorded sales
</div>
</div>

</div>

<div class="table-wrap">

<table class="table">

<thead>

<tr>
<th>Order</th>
<th>Customer</th>
<th>Items</th>
<th>Total</th>
<th>Status</th>
</tr>

</thead>

<tbody id="ordersTable"></tbody>

</table>

</div>

</div>

</div>

<div id="error" style="display:none"></div>

</div>

</main>

</div>

<nav class="mobile">

<button onclick="location.href='index.html'">
⌂<br>Home
</button>

<button onclick="location.href='products.html'">
▣<br>Products
</button>

<button class="active">
◒<br>Analytics
</button>

<button onclick="location.href='customers.html'">
♙<br>Customers
</button>

<button onclick="location.href='settings.html'">
⚙<br>Settings
</button>

</nav>

<script>

function money(value){

return "₹"+Number(value||0).toLocaleString("en-IN",{
maximumFractionDigits:2
});

}

function escapeText(value){

return String(value ?? "")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}

function getNumber(obj,keys){

for(const key of keys){

if(obj && obj[key]!==undefined){

const value=Number(obj[key]);

if(Number.isFinite(value)){
return value;
}

}

}

return 0;

}

function getArray(obj,keys){

for(const key of keys){

if(obj && Array.isArray(obj[key])){

return obj[key];

}

}

return [];

}

function drawChart(elementId,values,formatter){

const box=document.getElementById(elementId);

if(!values.length){

box.innerHTML='<div class="empty">No sales data yet.</div>';

return;

}

const max=Math.max(...values.map(v=>Number(v)||0),1);

box.innerHTML=values.map(function(value,index){

const height=Math.max(
4,
((Number(value)||0)/max)*190
);

return`

<div class="bar-wrap">

<div class="bar-value">
${escapeText(formatter(value))}
</div>

<div
class="bar"
style="height:${height}px">
</div>

<div class="bar-label">
${index+1}
</div>

</div>

`;

}).join("");

}

async function loadAnalytics(){

const loading=document.getElementById("loading");
const content=document.getElementById("content");
const error=document.getElementById("error");

loading.style.display="block";
content.style.display="none";
error.style.display="none";

try{

const response =
await fetch("/api/analytics/overview");

if(!response.ok){

throw new Error(
"Analytics API returned "+response.status
);

}

const data = await response.json();

const summary = data.summary || {};

const revenue =
Number(summary.totalRevenue || 0);

const orders =
Number(summary.totalOrders || 0);

const units =
Number(summary.unitsSold || 0);

const aov =
Number(summary.averageOrderValue || 0);

const customers =
Array.isArray(data.topCustomers)
? data.topCustomers.length
: 0;

document.getElementById("revenue")
.textContent = money(revenue);

document.getElementById("orders")
.textContent =
orders.toLocaleString("en-IN");

document.getElementById("aov")
.textContent = money(aov);

document.getElementById("customers")
.textContent =
customers.toLocaleString("en-IN");


/* SALES BY DAY */

const salesByDay =
Array.isArray(data.salesByDay)
? data.salesByDay
: [];

const revenueValues =
salesByDay.map(function(day){

return Number(
day.revenue ??
day.totalRevenue ??
day.sales ??
day.amount ??
0
);

});

const orderValues =
salesByDay.map(function(day){

return Number(
day.orders ??
day.totalOrders ??
day.orderCount ??
day.count ??
0
);

});


drawChart(
"revenueChart",
revenueValues,
money
);

drawChart(
"orderChart",
orderValues,
function(value){

return Number(value || 0)
.toLocaleString("en-IN");

}
);


/* TOP PRODUCTS */

const productData =
Array.isArray(data.topProducts)
? data.topProducts
: [];

const productTable =
document.getElementById("productsTable");

if(!productData.length){

productTable.innerHTML=`
<tr>
<td colspan="4">
<div class="empty">
No product sales recorded yet.
</div>
</td>
</tr>
`;

}else{

productTable.innerHTML =
productData
.slice(0,10)
.map(function(item){

const name =
item.name ??
item.productName ??
item.product ??
"Unknown Product";

const units =
Number(
item.unitsSold ??
item.units ??
item.quantity ??
item.qty ??
0
);

const count =
Number(
item.orders ??
item.orderCount ??
0
);

const total =
Number(
item.revenue ??
item.sales ??
item.totalRevenue ??
item.total ??
0
);

return`

<tr>

<td>
<strong>
${escapeText(name)}
</strong>
</td>

<td>
${units.toLocaleString("en-IN")}
</td>

<td>
${count.toLocaleString("en-IN")}
</td>

<td>
<strong>
${money(total)}
</strong>
</td>

</tr>

`;

})
.join("");

}


/* TOP CUSTOMERS */

const orderData =
Array.isArray(data.topCustomers)
? data.topCustomers
: [];

const orderTable =
document.getElementById("ordersTable");

if(!orderData.length){

orderTable.innerHTML=`
<tr>
<td colspan="5">
<div class="empty">
No customer sales recorded yet.
</div>
</td>
</tr>
`;

}else{

orderTable.innerHTML =
orderData
.slice(0,15)
.map(function(item,index){

const customer =
item.name ??
item.customerName ??
item.customer ??
"Customer";

const count =
Number(
item.orders ??
item.orderCount ??
0
);

const total =
Number(
item.revenue ??
item.totalRevenue ??
item.sales ??
item.total ??
0
);

return`

<tr>

<td>
<strong>
#${index+1}
</strong>
</td>

<td>
${escapeText(customer)}
</td>

<td>
${count.toLocaleString("en-IN")}
</td>

<td>
<strong>
${money(total)}
</strong>
</td>

<td>
<span class="badge">
Customer
</span>
</td>

</tr>

`;

})
.join("");

}


loading.style.display="none";
content.style.display="block";

}catch(err){

console.error(err);

loading.style.display="none";

error.style.display="block";

error.className="error";

error.innerHTML=`
<strong>
Unable to load sales analytics.
</strong>

<div style="margin-top:7px">
${escapeText(err.message)}
</div>
`;

}

}


function toggleTheme(){

const html=document.documentElement;

const dark=
html.getAttribute("data-theme")==="dark";

if(dark){

html.removeAttribute("data-theme");

localStorage.setItem("b2b_theme","light");

document.getElementById("themeButton")
.textContent="☾";

}else{

html.setAttribute("data-theme","dark");

localStorage.setItem("b2b_theme","dark");

document.getElementById("themeButton")
.textContent="☀";

}

}

if(
localStorage.getItem("b2b_theme")==="dark"
){

document.documentElement
.setAttribute("data-theme","dark");

document.getElementById("themeButton")
.textContent="☀";

}

loadAnalytics();

</script>

</body>
</html>
