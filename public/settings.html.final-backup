<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>B2B Wholesale Pricing Fast — Settings</title>

<style>

:root{
--bg:#f6f7f8;
--card:#fff;
--text:#202223;
--muted:#6d7175;
--border:#e1e3e5;
--primary:#008060;
--soft:#e7f5ef;
}

[data-theme="dark"]{
--bg:#101312;
--card:#181c1a;
--text:#f1f3f2;
--muted:#a6ada9;
--border:#303633;
--primary:#35b98a;
--soft:#17382d;
}

*{
box-sizing:border-box;
}

body{
margin:0;
background:var(--bg);
color:var(--text);
font-family:Arial,sans-serif;
}

button,input,select{
font:inherit;
}

.header{
height:64px;
background:var(--card);
border-bottom:1px solid var(--border);
display:flex;
align-items:center;
justify-content:space-between;
padding:0 18px;
position:sticky;
top:0;
z-index:20;
}

.brand{
display:flex;
align-items:center;
gap:10px;
font-weight:700;
}

.logo{
width:36px;
height:36px;
border-radius:9px;
background:var(--primary);
color:#fff;
display:grid;
place-items:center;
font-weight:800;
}

.brand span{
color:var(--primary);
}

.right{
display:flex;
align-items:center;
gap:8px;
}

.icon{
width:38px;
height:38px;
border:0;
background:transparent;
color:var(--text);
border-radius:8px;
cursor:pointer;
}

.store{
border:1px solid var(--border);
background:var(--card);
color:var(--text);
border-radius:9px;
padding:4px 7px 4px 12px;
display:flex;
align-items:center;
gap:8px;
}

.avatar{
width:30px;
height:30px;
border-radius:8px;
background:var(--primary);
color:#fff;
display:grid;
place-items:center;
font-weight:bold;
}

.layout{
display:flex;
min-height:calc(100vh - 64px);
}

.sidebar{
width:230px;
background:var(--card);
border-right:1px solid var(--border);
position:fixed;
top:64px;
bottom:0;
padding:18px 12px;
}

.label{
font-size:10px;
font-weight:bold;
color:var(--muted);
letter-spacing:1px;
padding:12px 10px 7px;
}

.nav{
width:100%;
border:0;
background:transparent;
color:var(--muted);
text-align:left;
padding:10px;
border-radius:8px;
cursor:pointer;
margin-bottom:3px;
}

.nav:hover{
background:var(--bg);
color:var(--text);
}

.nav.active{
background:var(--soft);
color:var(--primary);
font-weight:bold;
}

.main{
margin-left:230px;
width:100%;
padding:28px;
}

.container{
max-width:900px;
margin:auto;
}

.top{
margin-bottom:24px;
}

.eyebrow{
color:var(--primary);
font-size:10px;
font-weight:bold;
letter-spacing:1px;
margin-bottom:7px;
}

h1{
margin:0;
font-size:28px;
}

.subtitle{
margin-top:7px;
font-size:13px;
color:var(--muted);
}

.section{
background:var(--card);
border:1px solid var(--border);
border-radius:11px;
margin-bottom:18px;
overflow:hidden;
}

.section-head{
padding:18px;
border-bottom:1px solid var(--border);
}

.section-title{
font-size:15px;
font-weight:bold;
}

.section-sub{
font-size:11px;
color:var(--muted);
margin-top:5px;
}

.body{
padding:20px;
}

.field{
margin-bottom:18px;
}

.field:last-child{
margin-bottom:0;
}

.field label{
display:block;
font-size:12px;
font-weight:bold;
margin-bottom:7px;
}

.field input,
.field select{
width:100%;
padding:11px;
border:1px solid var(--border);
border-radius:8px;
background:var(--card);
color:var(--text);
outline:none;
}

.field small{
display:block;
margin-top:6px;
font-size:10px;
color:var(--muted);
}

.row{
display:grid;
grid-template-columns:1fr 1fr;
gap:15px;
}

.toggle-row{
display:flex;
align-items:center;
justify-content:space-between;
gap:20px;
padding:15px 0;
border-bottom:1px solid var(--border);
}

.toggle-row:last-child{
border-bottom:0;
}

.toggle-title{
font-size:12px;
font-weight:bold;
}

.toggle-sub{
font-size:10px;
color:var(--muted);
margin-top:4px;
}

.switch{
position:relative;
width:44px;
height:24px;
flex-shrink:0;
}

.switch input{
display:none;
}

.slider{
position:absolute;
inset:0;
background:var(--border);
border-radius:30px;
cursor:pointer;
transition:.2s;
}

.slider:before{
content:"";
position:absolute;
width:18px;
height:18px;
left:3px;
top:3px;
background:white;
border-radius:50%;
transition:.2s;
}

.switch input:checked+.slider{
background:var(--primary);
}

.switch input:checked+.slider:before{
transform:translateX(20px);
}

.footer{
display:flex;
justify-content:flex-end;
gap:8px;
padding:16px 20px;
border-top:1px solid var(--border);
}

.btn{
border:1px solid var(--border);
background:var(--card);
color:var(--text);
padding:10px 14px;
border-radius:8px;
cursor:pointer;
font-weight:bold;
}

.primary{
background:var(--primary);
border-color:var(--primary);
color:#fff;
}

.danger{
color:#c0392b;
border-color:#e4b8b2;
}

.status{
display:flex;
align-items:center;
gap:8px;
font-size:11px;
color:var(--muted);
margin-top:8px;
}

.dot{
width:8px;
height:8px;
border-radius:50%;
background:var(--primary);
}

.mobile{
display:none;
}

@media(max-width:800px){

.sidebar{
display:none;
}

.main{
margin-left:0;
padding:22px 15px 80px;
}

.row{
grid-template-columns:1fr;
}

.mobile{
position:fixed;
bottom:0;
left:0;
right:0;
height:64px;
background:var(--card);
border-top:1px solid var(--border);
display:flex;
justify-content:space-around;
z-index:30;
}

.mobile button{
border:0;
background:transparent;
color:var(--muted);
font-size:10px;
}

.mobile .active{
color:var(--primary);
font-weight:bold;
}

}

@media(max-width:500px){

.brand{
font-size:12px;
}

.store span{
display:none;
}

}

</style>
</head>

<body>

<header class="header">

<div class="brand">

<div class="logo">BF</div>

<div>
B2B Wholesale Pricing <span>Fast</span>
</div>

</div>

<div class="right">

<button
class="icon"
id="theme"
onclick="toggleTheme()">☾</button>

<button class="icon">🔔</button>

<div class="store">

<span>My Store</span>

<div class="avatar">M</div>

</div>

</div>

</header>


<div class="layout">

<aside class="sidebar">

<div class="label">OVERVIEW</div>

<button
class="nav"
onclick="location.href='index.html'">
⌂ &nbsp; Dashboard
</button>

<div class="label">COMMERCE</div>

<button
class="nav"
onclick="location.href='index.html'">
◇ &nbsp; Pricing Rules
</button>

<button
class="nav"
onclick="location.href='customers.html'">
♙ &nbsp; Customer Groups
</button>

<button
class="nav"
onclick="location.href='products.html'">
▣ &nbsp; Products
</button>

<button
class="nav"
onclick="location.href='price-lists.html'">
▤ &nbsp; Price Lists
</button>

<div class="label">INSIGHTS</div>

<button
class="nav"
onclick="location.href='analytics.html'">
◒ &nbsp; Analytics
</button>

<div class="label">SYSTEM</div>

<button class="nav active">
⚙ &nbsp; Settings
</button>

</aside>


<main class="main">

<div class="container">

<div class="top">

<div class="eyebrow">
SYSTEM
</div>

<h1>
Settings
</h1>

<div class="subtitle">
Configure your wholesale pricing workspace.
</div>

</div>


<div class="section">

<div class="section-head">

<div class="section-title">
Store settings
</div>

<div class="section-sub">
Basic information about your B2B workspace.
</div>

</div>

<div class="body">

<div class="row">

<div class="field">

<label>
Store name
</label>

<input
id="storeName"
placeholder="My Store">

</div>

<div class="field">

<label>
Currency
</label>

<select id="currency">

<option value="INR">Indian Rupee (₹)</option>
<option value="USD">US Dollar ($)</option>
<option value="EUR">Euro (€)</option>
<option value="GBP">British Pound (£)</option>

</select>

</div>

</div>


<div class="field">

<label>
Store email
</label>

<input
id="storeEmail"
type="email"
placeholder="admin@example.com">

</div>

</div>

<div class="footer">

<button
class="btn primary"
onclick="saveSettings()">
Save settings
</button>

</div>

</div>


<div class="section">

<div class="section-head">

<div class="section-title">
Wholesale settings
</div>

<div class="section-sub">
Control how wholesale pricing behaves.
</div>

</div>

<div class="body">

<div class="toggle-row">

<div>

<div class="toggle-title">
Enable wholesale pricing
</div>

<div class="toggle-sub">
Allow customer groups to receive wholesale prices.
</div>

</div>

<label class="switch">

<input
type="checkbox"
id="wholesaleEnabled">

<span class="slider"></span>

</label>

</div>


<div class="toggle-row">

<div>

<div class="toggle-title">
Automatic customer tagging
</div>

<div class="toggle-sub">
Automatically assign customers based on their tags.
</div>

</div>

<label class="switch">

<input
type="checkbox"
id="autoTagging">

<span class="slider"></span>

</label>

</div>


<div class="toggle-row">

<div>

<div class="toggle-title">
Apply price lists automatically
</div>

<div class="toggle-sub">
Use customer groups to determine the correct price list.
</div>

</div>

<label class="switch">

<input
type="checkbox"
id="autoPricing">

<span class="slider"></span>

</label>

</div>

</div>

<div class="footer">

<button
class="btn primary"
onclick="saveWholesaleSettings()">
Save wholesale settings
</button>

</div>

</div>


<div class="section">

<div class="section-head">

<div class="section-title">
Appearance
</div>

<div class="section-sub">
Customize the dashboard appearance.
</div>

</div>

<div class="body">

<div class="field">

<label>
Theme
</label>

<select
id="themeSelect"
onchange="changeTheme(this.value)">

<option value="light">
Light
</option>

<option value="dark">
Dark
</option>

</select>

<small>
Your theme preference is saved automatically.
</small>

</div>

</div>

</div>


<div class="section">

<div class="section-head">

<div class="section-title">
System status
</div>

<div class="section-sub">
Current application status.
</div>

</div>

<div class="body">

<div class="status">

<div class="dot"></div>

Local application storage is working

</div>

<div class="status">

<div class="dot"></div>

Pricing engine is ready

</div>

<div class="status">

<div class="dot"></div>

Customer groups are available

</div>

</div>

</div>


<div class="section">

<div class="section-head">

<div class="section-title">
Danger zone
</div>

<div class="section-sub">
These actions affect locally stored application data.
</div>

</div>

<div class="body">

<button
class="btn danger"
onclick="resetData()">
Reset local application data
</button>

</div>

</div>

</div>

</main>

</div>


<nav class="mobile">

<button onclick="location.href='index.html'">
⌂<br>Home
</button>

<button onclick="location.href='products.html'">
▣<br>Products
</button>

<button onclick="location.href='price-lists.html'">
▤<br>Prices
</button>

<button onclick="location.href='analytics.html'">
◒<br>Analytics
</button>

<button class="active">
⚙<br>Settings
</button>

</nav>


<script>

const defaults={

storeName:"My Store",

currency:"INR",

storeEmail:"",

wholesaleEnabled:true,

autoTagging:true,

autoPricing:true

};


function getSettings(){

try{

const saved=
JSON.parse(
localStorage.getItem("b2b_settings")
);

return Object.assign(
{},
defaults,
saved || {}
);

}catch(e){

return Object.assign({},defaults);

}

}


function loadSettings(){

const settings=getSettings();

document.getElementById("storeName")
.value=settings.storeName;

document.getElementById("currency")
.value=settings.currency;

document.getElementById("storeEmail")
.value=settings.storeEmail;

document.getElementById("wholesaleEnabled")
.checked=settings.wholesaleEnabled;

document.getElementById("autoTagging")
.checked=settings.autoTagging;

document.getElementById("autoPricing")
.checked=settings.autoPricing;


const theme=
localStorage.getItem("b2b_theme") || "light";

document.getElementById("themeSelect")
.value=theme;

}


function saveSettings(){

const settings=getSettings();

settings.storeName=
document.getElementById("storeName")
.value.trim()
||"My Store";

settings.currency=
document.getElementById("currency")
.value;

settings.storeEmail=
document.getElementById("storeEmail")
.value.trim();

localStorage.setItem(
"b2b_settings",
JSON.stringify(settings)
);

alert("Store settings saved.");

}


function saveWholesaleSettings(){

const settings=getSettings();

settings.wholesaleEnabled=
document.getElementById("wholesaleEnabled")
.checked;

settings.autoTagging=
document.getElementById("autoTagging")
.checked;

settings.autoPricing=
document.getElementById("autoPricing")
.checked;

localStorage.setItem(
"b2b_settings",
JSON.stringify(settings)
);

alert("Wholesale settings saved.");

}


function changeTheme(theme){

if(theme==="dark"){

document.documentElement
.setAttribute("data-theme","dark");

localStorage.setItem(
"b2b_theme",
"dark"
);

document.getElementById("theme")
.textContent="☀";

}else{

document.documentElement
.removeAttribute("data-theme");

localStorage.setItem(
"b2b_theme",
"light"
);

document.getElementById("theme")
.textContent="☾";

}

}


function toggleTheme(){

const current=
localStorage.getItem("b2b_theme")
||"light";

changeTheme(
current==="dark"
?"light"
:"dark"
);

document.getElementById("themeSelect")
.value=
current==="dark"
?"light"
:"dark";

}


function resetData(){

const confirmed=
confirm(
"This will delete locally stored products, groups, price lists, rules and settings. Continue?"
);

if(!confirmed)return;

const keys=[

"b2b_products",
"b2b_groups",
"b2b_price_lists",
"b2b_rules",
"b2b_settings"

];

keys.forEach(function(key){

localStorage.removeItem(key);

});

alert(
"Local application data has been reset."
);

location.reload();

}


if(
localStorage.getItem("b2b_theme")==="dark"
){

document.documentElement
.setAttribute(
"data-theme",
"dark"
);

document.getElementById("theme")
.textContent="☀";

}


loadSettings();

</script>

</body>
</html>
