<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>B2B Wholesale Pricing Fast — Orders</title>

<style>
:root{
--bg:#f6f7f8;
--card:#fff;
--text:#202223;
--muted:#6d7175;
--border:#e1e3e5;
--primary:#008060;
--soft:#e7f5ef;
--danger:#d72c0d;
}

[data-theme="dark"]{
--bg:#101312;
--card:#181c1a;
--text:#f1f3f2;
--muted:#a6ada9;
--border:#303633;
--primary:#35b98a;
--soft:#17382d;
--danger:#ff8a75;
}

*{box-sizing:border-box}

body{
margin:0;
background:var(--bg);
color:var(--text);
font-family:Arial,sans-serif;
}

button,input,select{
font:inherit;
}

.header{
height:64px;
background:var(--card);
border-bottom:1px solid var(--border);
display:flex;
align-items:center;
justify-content:space-between;
padding:0 18px;
position:sticky;
top:0;
z-index:20;
}

.brand{
display:flex;
align-items:center;
gap:10px;
font-weight:700;
}

.logo{
width:36px;
height:36px;
border-radius:9px;
background:var(--primary);
color:#fff;
display:grid;
place-items:center;
font-weight:800;
}

.brand span{
color:var(--primary);
}

.right{
display:flex;
align-items:center;
gap:8px;
}

.icon{
width:38px;
height:38px;
border:0;
background:transparent;
color:var(--text);
border-radius:8px;
cursor:pointer;
}

.store{
border:1px solid var(--border);
background:var(--card);
color:var(--text);
border-radius:9px;
padding:4px 7px 4px 12px;
display:flex;
align-items:center;
gap:8px;
}

.avatar{
width:30px;
height:30px;
border-radius:8px;
background:var(--primary);
color:#fff;
display:grid;
place-items:center;
font-weight:bold;
}

.layout{
display:flex;
min-height:calc(100vh - 64px);
}

.sidebar{
width:230px;
background:var(--card);
border-right:1px solid var(--border);
position:fixed;
top:64px;
bottom:0;
padding:18px 12px;
}

.label{
font-size:10px;
font-weight:bold;
color:var(--muted);
letter-spacing:1px;
padding:12px 10px 7px;
}

.nav{
width:100%;
border:0;
background:transparent;
color:var(--muted);
text-align:left;
padding:10px;
border-radius:8px;
cursor:pointer;
margin-bottom:3px;
}

.nav:hover{
background:var(--bg);
color:var(--text);
}

.nav.active{
background:var(--soft);
color:var(--primary);
font-weight:bold;
}

.main{
margin-left:230px;
width:100%;
padding:28px;
}

.container{
max-width:1150px;
margin:auto;
}

.top{
display:flex;
justify-content:space-between;
align-items:end;
gap:20px;
margin-bottom:24px;
}

.eyebrow{
color:var(--primary);
font-size:10px;
font-weight:bold;
letter-spacing:1px;
margin-bottom:7px;
}

h1{
margin:0;
font-size:28px;
}

.subtitle{
margin-top:7px;
font-size:13px;
color:var(--muted);
}

.btn{
border:1px solid var(--border);
background:var(--card);
color:var(--text);
padding:10px 14px;
border-radius:8px;
cursor:pointer;
font-weight:bold;
}

.primary{
background:var(--primary);
border-color:var(--primary);
color:#fff;
}

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
margin-bottom:18px;
}

.stat{
background:var(--card);
border:1px solid var(--border);
border-radius:11px;
padding:18px;
}

.stat-title{
font-size:12px;
color:var(--muted);
}

.stat-number{
font-size:25px;
font-weight:bold;
margin-top:7px;
}

.panel{
background:var(--card);
border:1px solid var(--border);
border-radius:11px;
overflow:hidden;
}

.toolbar{
padding:14px;
border-bottom:1px solid var(--border);
display:flex;
gap:10px;
}

.search{
flex:1;
}

.search input{
width:100%;
padding:10px 12px;
border:1px solid var(--border);
border-radius:8px;
background:var(--card);
color:var(--text);
outline:none;
}

.order{
padding:17px;
border-bottom:1px solid var(--border);
display:flex;
align-items:center;
gap:15px;
}

.order:last-child{
border-bottom:0;
}

.order-icon{
width:44px;
height:44px;
border-radius:10px;
background:var(--soft);
color:var(--primary);
display:grid;
place-items:center;
font-weight:bold;
}

.info{
flex:1;
min-width:0;
}

.order-number{
font-weight:bold;
font-size:14px;
}

.customer{
font-size:12px;
color:var(--muted);
margin-top:5px;
}

.meta{
display:flex;
gap:6px;
flex-wrap:wrap;
margin-top:7px;
}

.badge{
background:var(--bg);
color:var(--muted);
padding:4px 7px;
border-radius:5px;
font-size:10px;
}

.amount{
font-weight:bold;
}

.status{
font-size:10px;
font-weight:bold;
padding:5px 9px;
border-radius:20px;
background:var(--soft);
color:var(--primary);
}

.empty{
padding:60px 20px;
text-align:center;
color:var(--muted);
}

.overlay{
position:fixed;
inset:0;
background:rgba(0,0,0,.5);
display:none;
align-items:center;
justify-content:center;
padding:18px;
z-index:100;
}

.modal{
width:100%;
max-width:620px;
max-height:92vh;
overflow:auto;
background:var(--card);
border:1px solid var(--border);
border-radius:13px;
}

.modal-head{
padding:18px;
border-bottom:1px solid var(--border);
display:flex;
justify-content:space-between;
align-items:center;
}

.modal-title{
font-size:18px;
font-weight:bold;
}

.body{
padding:20px;
}

.field{
margin-bottom:16px;
}

.field label{
display:block;
font-size:12px;
font-weight:bold;
margin-bottom:7px;
}

.field input,
.field select{
width:100%;
padding:11px;
border:1px solid var(--border);
border-radius:8px;
background:var(--card);
color:var(--text);
outline:none;
}

.product-row{
display:grid;
grid-template-columns:2fr 1fr 1fr 40px;
gap:7px;
margin-bottom:8px;
}

.product-row input,
.product-row select{
width:100%;
padding:10px;
border:1px solid var(--border);
border-radius:8px;
background:var(--card);
color:var(--text);
}

.remove{
border:1px solid var(--border);
background:var(--card);
color:var(--danger);
border-radius:7px;
cursor:pointer;
}

.add{
width:100%;
padding:10px;
border:1px dashed var(--border);
background:transparent;
color:var(--primary);
border-radius:8px;
cursor:pointer;
margin-top:5px;
}

.footer{
padding:14px 18px;
border-top:1px solid var(--border);
display:flex;
justify-content:flex-end;
gap:8px;
}

.mobile{
display:none;
}

@media(max-width:800px){

.sidebar{
display:none;
}

.main{
margin-left:0;
padding:22px 15px 80px;
}

.top{
display:block;
}

.top .primary{
width:100%;
margin-top:15px;
}

.stats{
grid-template-columns:1fr;
}

.order{
align-items:flex-start;
}

.amount{
display:none;
}

.mobile{
position:fixed;
bottom:0;
left:0;
right:0;
height:64px;
background:var(--card);
border-top:1px solid var(--border);
display:flex;
justify-content:space-around;
z-index:30;
}

.mobile button{
border:0;
background:transparent;
color:var(--muted);
font-size:10px;
}

.mobile .active{
color:var(--primary);
font-weight:bold;
}

}

@media(max-width:500px){

.brand{
font-size:12px;
}

.store span{
display:none;
}

.product-row{
grid-template-columns:1fr 1fr 38px;
}

.product-row select{
grid-column:1 / 4;
}

}
</style>
</head>

<body>

<header class="header">

<div class="brand">
<div class="logo">BF</div>
<div>B2B Wholesale Pricing <span>Fast</span></div>
</div>

<div class="right">

<button class="icon" id="theme" onclick="toggleTheme()">☾</button>

<button class="icon">🔔</button>

<div class="store">
<span>My Store</span>
<div class="avatar">M</div>
</div>

</div>

</header>

<div class="layout">

<aside class="sidebar">

<div class="label">OVERVIEW</div>

<button class="nav" onclick="location.href='index.html'">
⌂ &nbsp; Dashboard
</button>

<div class="label">COMMERCE</div>

<button class="nav" onclick="location.href='index.html'">
◇ &nbsp; Pricing Rules
</button>

<button class="nav" onclick="location.href='customers.html'">
♙ &nbsp; Customer Groups
</button>

<button class="nav" onclick="location.href='products.html'">
▣ &nbsp; Products
</button>

<button class="nav">
▤ &nbsp; Price Lists
</button>

<div class="label">SALES</div>

<button class="nav active">
▤ &nbsp; Orders
</button>

<div class="label">INSIGHTS</div>

<button class="nav" onclick="location.href='analytics.html'">
◒ &nbsp; Analytics
</button>

<div class="label">SYSTEM</div>

<button class="nav">
⚙ &nbsp; Settings
</button>

</aside>

<main class="main">

<div class="container">

<div class="top">

<div>

<div class="eyebrow">SALES</div>

<h1>Orders</h1>

<div class="subtitle">
Track every wholesale sale and customer order.
</div>

</div>

<button class="btn primary" onclick="openCreate()">
+ Create order
</button>

</div>

<div class="stats">

<div class="stat">
<div class="stat-title">Orders</div>
<div class="stat-number" id="orderCount">0</div>
</div>

<div class="stat">
<div class="stat-title">Revenue</div>
<div class="stat-number" id="revenue">₹0</div>
</div>

<div class="stat">
<div class="stat-title">Units Sold</div>
<div class="stat-number" id="units">0</div>
</div>

</div>

<div class="panel">

<div class="toolbar">

<div class="search">

<input
id="search"
placeholder="Search orders or customers..."
oninput="render()">

</div>

</div>

<div id="orders">

<div class="empty">
Loading orders...
</div>

</div>

</div>

</div>

</main>

</div>

<nav class="mobile">

<button onclick="location.href='index.html'">
⌂<br>Home
</button>

<button onclick="location.href='products.html'">
▣<br>Products
</button>

<button class="active">
▤<br>Orders
</button>

<button onclick="location.href='analytics.html'">
◒<br>Analytics
</button>

<button onclick="location.href='customers.html'">
♙<br>Customers
</button>

</nav>

<div class="overlay" id="overlay">

<div class="modal">

<div class="modal-head">

<div class="modal-title">
Create order
</div>

<button class="icon" onclick="closeModal()">✕</button>

</div>

<div class="body">

<div class="field">

<label>Customer name</label>

<input
id="customerName"
placeholder="Example: ABC Wholesale">

</div>

<div class="field">

<label>Customer email</label>

<input
id="customerEmail"
type="email"
placeholder="customer@example.com">

</div>

<div class="field">

<label>Customer group</label>

<select id="customerGroup">

<option>Retail</option>
<option>Wholesale</option>
<option>VIP Distributor</option>
<option>Enterprise</option>

</select>

</div>

<div class="field">

<label>Products</label>

<div id="productRows"></div>

<button class="add" onclick="addProductRow()">
+ Add product
</button>

</div>

<div class="field">

<label>Order status</label>

<select id="orderStatus">

<option value="pending">Pending</option>
<option value="processing">Processing</option>
<option value="completed">Completed</option>
<option value="cancelled">Cancelled</option>

</select>

</div>

<div class="field">

<label>Payment status</label>

<select id="paymentStatus">

<option value="unpaid">Unpaid</option>
<option value="partial">Partially paid</option>
<option value="paid">Paid</option>

</select>

</div>

</div>

<div class="footer">

<button class="btn" onclick="closeModal()">
Cancel
</button>

<button class="btn primary" onclick="saveOrder()">
Create order
</button>

</div>

</div>

</div>

<script>

let orders=[];
let products=[];

function money(value){

return "₹"+Number(value||0).toLocaleString("en-IN",{
maximumFractionDigits:2
});

}

function escapeText(value){

return String(value)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}

async function load(){

try{

const orderResponse=
await fetch("/api/orders");

const productResponse=
await fetch("/api/products");

if(!orderResponse.ok || !productResponse.ok){

throw new Error("Failed to load data");

}

orders=
await orderResponse.json();

products=
await productResponse.json();

if(!Array.isArray(orders))orders=[];
if(!Array.isArray(products))products=[];

render();

}catch(error){

console.error(error);

document.getElementById("orders").innerHTML=
'<div class="empty">Unable to load orders.</div>';

}

}

function render(){

const query=
document.getElementById("search")
.value
.toLowerCase();

const filtered=
orders.filter(function(order){

return String(order.orderNumber||"")
.toLowerCase()
.includes(query)
||
String(order.customerName||"")
.toLowerCase()
.includes(query);

});

document.getElementById("orderCount")
.textContent=orders.length;

document.getElementById("revenue")
.textContent=
money(
orders.reduce(
(sum,order)=>sum+Number(order.total||0),
0
)
);

document.getElementById("units")
.textContent=
orders.reduce(
(sum,order)=>sum+Number(order.units||0),
0
);

const box=document.getElementById("orders");

if(!filtered.length){

box.innerHTML=
'<div class="empty"><strong>No orders yet</strong><div style="margin-top:7px">Create your first sale to start tracking revenue.</div></div>';

return;

}

box.innerHTML=
filtered.map(function(order){

return`

<div class="order">

<div class="order-icon">
$
</div>

<div class="info">

<div class="order-number">
${escapeText(order.orderNumber||"Order")}
</div>

<div class="customer">
${escapeText(order.customerName||"Unknown customer")}
</div>

<div class="meta">

<span class="badge">
${Number(order.units||0)} units
</span>

<span class="badge">
${escapeText(order.customerGroup||"Retail")}
</span>

<span class="badge">
Payment: ${escapeText(order.paymentStatus||"unpaid")}
</span>

</div>

</div>

<div class="status">
${escapeText(order.status||"pending")}
</div>

<div class="amount">
${money(order.total)}
</div>

</div>

`;

}).join("");

}

function openCreate(){

document.getElementById("customerName").value="";
document.getElementById("customerEmail").value="";
document.getElementById("customerGroup").value="Wholesale";
document.getElementById("orderStatus").value="pending";
document.getElementById("paymentStatus").value="unpaid";

document.getElementById("productRows").innerHTML="";

addProductRow();

document.getElementById("overlay")
.style.display="flex";

}

function closeModal(){

document.getElementById("overlay")
.style.display="none";

}

function addProductRow(){

const container=
document.getElementById("productRows");

const row=
document.createElement("div");

row.className="product-row";

const select=
document.createElement("select");

select.innerHTML=
'<option value="">Select product</option>'+
products.map(function(product){

return`

<option value="${product.id}">
${escapeText(product.name)} — ${money(product.price)}
</option>

`;

}).join("");

const quantity=
document.createElement("input");

quantity.type="number";
quantity.min="1";
quantity.value="1";
quantity.placeholder="Qty";

const discount=
document.createElement("input");

discount.type="number";
discount.min="0";
discount.max="100";
discount.value="0";
discount.placeholder="Discount %";

const remove=
document.createElement("button");

remove.className="remove";
remove.textContent="×";

remove.onclick=function(){
row.remove();
};

row.appendChild(select);
row.appendChild(quantity);
row.appendChild(discount);
row.appendChild(remove);

container.appendChild(row);

}

async function saveOrder(){

const customerName=
document.getElementById("customerName")
.value.trim();

const customerEmail=
document.getElementById("customerEmail")
.value.trim();

const customerGroup=
document.getElementById("customerGroup")
.value;

const rows=
document.querySelectorAll(".product-row");

if(!customerName){

alert("Enter the customer name.");

return;

}

if(!rows.length){

alert("Add at least one product.");

return;

}

const items=[];

for(const row of rows){

const select=row.querySelector("select");
const inputs=row.querySelectorAll("input");

const productId=
Number(select.value);

const quantity=
Number(inputs[0].value);

const discount=
Number(inputs[1].value||0);

const product=
products.find(
p=>Number(p.id)===productId
);

if(!product){

alert("Select a product for every row.");

return;

}

if(!Number.isFinite(quantity)||quantity<1){

alert("Quantity must be at least 1.");

return;

}

if(!Number.isFinite(discount)||discount<0||discount>100){

alert("Discount must be between 0 and 100.");

return;

}

items.push({

productId:product.id,

name:product.name,

sku:product.sku,

quantity:quantity,

price:Number(product.price||0),

discount:discount

});

}

const payload={

customerName:customerName,

customerEmail:customerEmail,

customerGroup:customerGroup,

items:items,

status:
document.getElementById("orderStatus").value,

paymentStatus:
document.getElementById("paymentStatus").value

};

try{

const response=
await fetch(
"/api/orders",
{
method:"POST",
headers:{
"Content-Type":"application/json"
},
body:JSON.stringify(payload)
}
);

const data=
await response.json();

if(!response.ok || !data.success){

throw new Error(
data.error||"Could not create order"
);

}

closeModal();

await load();

alert(
"Order "+data.order.orderNumber+" created successfully."
);

}catch(error){

console.error(error);

alert(error.message);

}

}

function toggleTheme(){

const html=
document.documentElement;

const dark=
html.getAttribute("data-theme")==="dark";

if(dark){

html.removeAttribute("data-theme");

localStorage.setItem("b2b_theme","light");

document.getElementById("theme")
.textContent="☾";

}else{

html.setAttribute("data-theme","dark");

localStorage.setItem("b2b_theme","dark");

document.getElementById("theme")
.textContent="☀";

}

}

if(
localStorage.getItem("b2b_theme")==="dark"
){

document.documentElement
.setAttribute("data-theme","dark");

document.getElementById("theme")
.textContent="☀";

}

load();

</script>

</body>
</html>
