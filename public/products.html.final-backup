<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>B2B Wholesale Pricing Fast — Products</title>

<style>
:root{
--bg:#f6f7f8;
--card:#fff;
--text:#202223;
--muted:#6d7175;
--border:#e1e3e5;
--primary:#008060;
--soft:#e7f5ef;
}

[data-theme="dark"]{
--bg:#101312;
--card:#181c1a;
--text:#f1f3f2;
--muted:#a6ada9;
--border:#303633;
--primary:#35b98a;
--soft:#17382d;
}

*{box-sizing:border-box}

body{
margin:0;
background:var(--bg);
color:var(--text);
font-family:Arial,sans-serif;
}

button,input,select{
font:inherit;
}

.header{
height:64px;
background:var(--card);
border-bottom:1px solid var(--border);
display:flex;
align-items:center;
justify-content:space-between;
padding:0 18px;
position:sticky;
top:0;
z-index:20;
}

.brand{
display:flex;
align-items:center;
gap:10px;
font-weight:700;
}

.logo{
width:36px;
height:36px;
border-radius:9px;
background:var(--primary);
color:#fff;
display:grid;
place-items:center;
font-weight:800;
}

.brand span{
color:var(--primary);
}

.right{
display:flex;
align-items:center;
gap:8px;
}

.icon{
width:38px;
height:38px;
border:0;
background:transparent;
color:var(--text);
border-radius:8px;
cursor:pointer;
}

.store{
border:1px solid var(--border);
background:var(--card);
color:var(--text);
border-radius:9px;
padding:4px 7px 4px 12px;
display:flex;
align-items:center;
gap:8px;
}

.avatar{
width:30px;
height:30px;
border-radius:8px;
background:var(--primary);
color:#fff;
display:grid;
place-items:center;
font-weight:bold;
}

.layout{
display:flex;
min-height:calc(100vh - 64px);
}

.sidebar{
width:230px;
background:var(--card);
border-right:1px solid var(--border);
position:fixed;
top:64px;
bottom:0;
padding:18px 12px;
}

.label{
font-size:10px;
font-weight:bold;
color:var(--muted);
letter-spacing:1px;
padding:12px 10px 7px;
}

.nav{
width:100%;
border:0;
background:transparent;
color:var(--muted);
text-align:left;
padding:10px;
border-radius:8px;
cursor:pointer;
margin-bottom:3px;
}

.nav:hover{
background:var(--bg);
color:var(--text);
}

.nav.active{
background:var(--soft);
color:var(--primary);
font-weight:bold;
}

.main{
margin-left:230px;
width:100%;
padding:28px;
}

.container{
max-width:1100px;
margin:auto;
}

.top{
display:flex;
justify-content:space-between;
align-items:end;
gap:20px;
margin-bottom:24px;
}

.eyebrow{
color:var(--primary);
font-size:10px;
font-weight:bold;
letter-spacing:1px;
margin-bottom:7px;
}

h1{
margin:0;
font-size:28px;
}

.subtitle{
margin-top:7px;
font-size:13px;
color:var(--muted);
}

.actions{
display:flex;
gap:8px;
}

.btn{
border:1px solid var(--border);
background:var(--card);
color:var(--text);
padding:10px 14px;
border-radius:8px;
cursor:pointer;
font-weight:bold;
}

.primary{
background:var(--primary);
border-color:var(--primary);
color:#fff;
}

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
margin-bottom:18px;
}

.stat{
background:var(--card);
border:1px solid var(--border);
border-radius:10px;
padding:18px;
}

.stat-title{
font-size:12px;
color:var(--muted);
}

.stat-number{
font-size:25px;
font-weight:bold;
margin-top:7px;
}

.panel{
background:var(--card);
border:1px solid var(--border);
border-radius:11px;
overflow:hidden;
}

.toolbar{
padding:14px;
border-bottom:1px solid var(--border);
display:flex;
gap:10px;
align-items:center;
}

.search{
flex:1;
}

.search input{
width:100%;
padding:10px 12px;
border:1px solid var(--border);
border-radius:8px;
background:var(--card);
color:var(--text);
outline:none;
}

.filter{
padding:10px;
border:1px solid var(--border);
border-radius:8px;
background:var(--card);
color:var(--text);
}

.product{
display:flex;
align-items:center;
gap:14px;
padding:16px;
border-bottom:1px solid var(--border);
}

.product:last-child{
border-bottom:0;
}

.product-image{
width:48px;
height:48px;
border-radius:9px;
background:var(--soft);
color:var(--primary);
display:grid;
place-items:center;
font-weight:bold;
font-size:16px;
}

.info{
flex:1;
min-width:0;
}

.name{
font-size:14px;
font-weight:bold;
margin-bottom:5px;
}

.meta{
display:flex;
flex-wrap:wrap;
gap:6px;
}

.badge{
background:var(--bg);
color:var(--muted);
padding:4px 7px;
border-radius:5px;
font-size:11px;
}

.price{
font-weight:bold;
font-size:14px;
min-width:90px;
text-align:right;
}

.buttons{
display:flex;
gap:5px;
}

.small{
width:34px;
height:34px;
border:1px solid var(--border);
background:var(--card);
color:var(--text);
border-radius:7px;
cursor:pointer;
}

.empty{
padding:60px 20px;
text-align:center;
color:var(--muted);
}

.overlay{
position:fixed;
inset:0;
background:rgba(0,0,0,.5);
display:none;
align-items:center;
justify-content:center;
padding:18px;
z-index:100;
}

.modal{
width:100%;
max-width:560px;
background:var(--card);
border:1px solid var(--border);
border-radius:13px;
overflow:hidden;
}

.modal-head{
padding:18px;
border-bottom:1px solid var(--border);
display:flex;
justify-content:space-between;
align-items:center;
}

.modal-title{
font-size:18px;
font-weight:bold;
}

.body{
padding:20px;
}

.field{
margin-bottom:16px;
}

.field label{
display:block;
font-size:12px;
font-weight:bold;
margin-bottom:7px;
}

.field input{
width:100%;
padding:11px;
border:1px solid var(--border);
border-radius:8px;
background:var(--card);
color:var(--text);
}

.footer{
padding:14px 18px;
border-top:1px solid var(--border);
display:flex;
justify-content:flex-end;
gap:8px;
}

.mobile{
display:none;
}

@media(max-width:800px){

.sidebar{
display:none;
}

.main{
margin-left:0;
padding:22px 15px 80px;
}

.top{
display:block;
}

.actions{
margin-top:16px;
}

.actions .primary{
width:100%;
}

.stats{
grid-template-columns:1fr;
}

.toolbar{
display:block;
}

.search{
margin-bottom:8px;
}

.filter{
width:100%;
}

.product{
align-items:flex-start;
}

.price{
display:none;
}

.mobile{
position:fixed;
bottom:0;
left:0;
right:0;
height:64px;
background:var(--card);
border-top:1px solid var(--border);
display:flex;
justify-content:space-around;
z-index:30;
}

.mobile button{
border:0;
background:transparent;
color:var(--muted);
font-size:10px;
}

.mobile .active{
color:var(--primary);
font-weight:bold;
}

}

@media(max-width:500px){

.brand{
font-size:12px;
}

.store span{
display:none;
}

.buttons{
flex-direction:column;
}

}
</style>
</head>

<body>

<header class="header">

<div class="brand">
<div class="logo">BF</div>
<div>B2B Wholesale <span>Fast</span></div>
</div>

<div class="right">

<button
class="icon"
id="theme"
onclick="toggleTheme()">☾</button>

<button class="icon">🔔</button>

<div class="store">
<span>My Store</span>
<div class="avatar">M</div>
</div>

</div>

</header>

<div class="layout">

<aside class="sidebar">

<div class="label">OVERVIEW</div>

<button class="nav"
onclick="location.href='index.html'">
⌂ &nbsp; Dashboard
</button>

<div class="label">COMMERCE</div>

<button class="nav"
onclick="location.href='index.html'">
◇ &nbsp; Pricing Rules
</button>

<button class="nav"
onclick="location.href='customers.html'">
♙ &nbsp; Customer Groups
</button>

<button class="nav active">
▣ &nbsp; Products
</button>

<button class="nav">
▤ &nbsp; Price Lists
</button>

<div class="label">INSIGHTS</div>

<button class="nav">
◒ &nbsp; Analytics
</button>

<div class="label">SYSTEM</div>

<button class="nav">
⚙ &nbsp; Settings
</button>

</aside>

<main class="main">

<div class="container">

<div class="top">

<div>

<div class="eyebrow">COMMERCE</div>

<h1>Products</h1>

<div class="subtitle">
Manage products and connect them with wholesale pricing rules.
</div>

</div>

<div class="actions">

<button
class="btn primary"
onclick="openCreate()">
+ Add product
</button>

</div>

</div>

<div class="stats">

<div class="stat">
<div class="stat-title">Total Products</div>
<div class="stat-number" id="totalProducts">0</div>
</div>

<div class="stat">
<div class="stat-title">Wholesale Products</div>
<div class="stat-number" id="wholesaleProducts">0</div>
</div>

<div class="stat">
<div class="stat-title">Average Price</div>
<div class="stat-number" id="averagePrice">₹0</div>
</div>

</div>

<div class="panel">

<div class="toolbar">

<div class="search">

<input
id="search"
placeholder="Search products..."
oninput="render()">

</div>

<select
class="filter"
id="filter"
onchange="render()">

<option value="all">All products</option>
<option value="wholesale">Wholesale enabled</option>
<option value="standard">Standard</option>

</select>

</div>

<div id="products"></div>

</div>

</div>

</main>

</div>

<nav class="mobile">

<button onclick="location.href='index.html'">
⌂<br>Home
</button>

<button onclick="location.href='index.html'">
◇<br>Pricing
</button>

<button class="active">
▣<br>Products
</button>

<button onclick="location.href='customers.html'">
♙<br>Customers
</button>

<button>
⚙<br>Settings
</button>

</nav>

<div class="overlay" id="overlay">

<div class="modal">

<div class="modal-head">

<div class="modal-title" id="modalTitle">
Add product
</div>

<button
class="icon"
onclick="closeModal()">✕</button>

</div>

<div class="body">

<div class="field">

<label>Product name</label>

<input
id="productName"
placeholder="Example: Premium Cotton T-Shirt">

</div>

<div class="field">

<label>SKU</label>

<input
id="sku"
placeholder="Example: TSHIRT-001">

</div>

<div class="field">

<label>Base price</label>

<input
id="price"
type="number"
min="0"
step="0.01"
placeholder="999">

</div>

<div class="field">

<label>Wholesale pricing</label>

<select id="wholesale">

<option value="yes">Enabled</option>
<option value="no">Disabled</option>

</select>

</div>

</div>

<div class="footer">

<button
class="btn"
onclick="closeModal()">
Cancel
</button>

<button
class="btn primary"
onclick="saveProduct()">
Save product
</button>

</div>

</div>

</div>

<script>

let products = [];
let editingId = null;

const starterProducts = [

{
id:1,
name:"Premium Cotton T-Shirt",
sku:"TSHIRT-001",
price:899,
wholesale:true
},

{
id:2,
name:"Classic Hoodie",
sku:"HOODIE-001",
price:1499,
wholesale:true
},

{
id:3,
name:"Running Sneakers",
sku:"SHOE-001",
price:2499,
wholesale:true
},

{
id:4,
name:"Everyday Backpack",
sku:"BAG-001",
price:1199,
wholesale:false
}

];


/* LOAD PRODUCTS FROM BACKEND */

async function loadProducts(){

try{

const response =
await fetch("/api/products");

if(!response.ok){

throw new Error(
"API returned HTTP " + response.status
);

}

let data =
await response.json();


/*
First-time migration:

If the backend has no products yet,
check the old localStorage data and move
it into the backend.
*/

if(
Array.isArray(data) &&
data.length === 0 &&
!localStorage.getItem("b2b_products_migrated")
){

let oldProducts = null;

try{

oldProducts =
JSON.parse(
localStorage.getItem("b2b_products")
);

}catch(error){

oldProducts = null;

}


if(
!Array.isArray(oldProducts) ||
oldProducts.length === 0
){

oldProducts = starterProducts;

}


const migrated = [];

for(
const oldProduct of oldProducts
){

const response =
await fetch("/api/products",{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({

name:oldProduct.name,
sku:oldProduct.sku,
price:Number(oldProduct.price || 0),
wholesale:Boolean(oldProduct.wholesale)

})

});


if(!response.ok){

throw new Error(
"Product migration failed."
);

}


const created =
await response.json();

migrated.push(created);

}


data = migrated;

localStorage.setItem(
"b2b_products_migrated",
"true"
);

}


/*
Backend is now the source of truth.
*/

products =
Array.isArray(data)
? data
: [];

render();

}catch(error){

console.error(error);

products = [];

render();

alert(
"Could not connect to the product database. Make sure the server is running."
);

}

}


/* SAVE TO BACKEND */

async function saveProduct(){

const name =
document.getElementById("productName")
.value
.trim();

const sku =
document.getElementById("sku")
.value
.trim();

const price =
Number(
document.getElementById("price").value
);

const wholesale =
document.getElementById("wholesale")
.value === "yes";


if(!name){

alert("Enter a product name.");

return;

}


if(!sku){

alert("Enter a SKU.");

return;

}


if(!Number.isFinite(price) || price < 0){

alert("Enter a valid price.");

return;

}


const productData = {

name:name,

sku:sku,

price:price,

wholesale:wholesale

};


try{

let response;


if(editingId !== null){

response =
await fetch(
"/api/products/" + editingId,
{

method:"PUT",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify(productData)

}
);

}else{

response =
await fetch(
"/api/products",
{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify(productData)

}
);

}


if(!response.ok){

throw new Error(
"Server returned HTTP " + response.status
);

}


const savedProduct =
await response.json();


if(editingId !== null){

products =
products.map(function(item){

return item.id === editingId
? savedProduct
: item;

});

}else{

products.unshift(savedProduct);

}


editingId = null;

render();

closeModal();

}catch(error){

console.error(error);

alert(
"Could not save the product."
);

}

}


/* DELETE FROM BACKEND */

async function deleteProduct(id){

const product =
products.find(function(p){

return p.id === id;

});


if(!product){

return;

}


if(
!confirm(
'Delete "' + product.name + '"?'
)
){

return;

}


try{

const response =
await fetch(
"/api/products/" + id,
{
method:"DELETE"
}
);


if(!response.ok){

throw new Error(
"Server returned HTTP " + response.status
);

}


products =
products.filter(function(p){

return p.id !== id;

});


render();

}catch(error){

console.error(error);

alert(
"Could not delete the product."
);

}

}


/* RENDER */

function render(){

const box =
document.getElementById("products");

const query =
document.getElementById("search")
.value
.toLowerCase();

const filter =
document.getElementById("filter")
.value;


const filtered =
products.filter(function(product){

const name =
String(product.name || "")
.toLowerCase();

const sku =
String(product.sku || "")
.toLowerCase();

const matchesSearch =
name.includes(query) ||
sku.includes(query);

const matchesFilter =
filter === "all" ||

(
filter === "wholesale" &&
Boolean(product.wholesale)
) ||

(
filter === "standard" &&
!Boolean(product.wholesale)
);

return matchesSearch && matchesFilter;

});


document.getElementById("totalProducts")
.textContent =
products.length;


document.getElementById("wholesaleProducts")
.textContent =
products.filter(
p => Boolean(p.wholesale)
).length;


const average =
products.length
? products.reduce(
(sum,p) =>
sum + Number(p.price || 0),
0
) / products.length
: 0;


document.getElementById("averagePrice")
.textContent =
"₹" +
Math.round(average)
.toLocaleString("en-IN");


if(!filtered.length){

box.innerHTML = `

<div class="empty">

<strong>No products found</strong>

<div style="margin-top:7px">

Add a product to start managing wholesale pricing.

</div>

</div>

`;

return;

}


box.innerHTML =
filtered.map(function(product){

return `

<div class="product">

<div class="product-image">

${escapeText(
String(product.name || "?")
.charAt(0)
.toUpperCase()
)}

</div>


<div class="info">

<div class="name">

${escapeText(
product.name || "Unnamed product"
)}

</div>


<div class="meta">

<span class="badge">

SKU: ${escapeText(
product.sku || "-"
)}

</span>


<span class="badge">

${
product.wholesale
? "Wholesale enabled"
: "Standard pricing"
}

</span>

</div>

</div>


<div class="price">

₹${Number(
product.price || 0
).toLocaleString("en-IN")}

</div>


<div class="buttons">

<button
class="small"
onclick="editProduct(${Number(product.id)})">

✎

</button>


<button
class="small"
onclick="deleteProduct(${Number(product.id)})">

×

</button>

</div>

</div>

`;

}).join("");

}


/* ESCAPE HTML */

function escapeText(value){

return String(value)

.replace(/&/g,"&amp;")

.replace(/</g,"&lt;")

.replace(/>/g,"&gt;")

.replace(/"/g,"&quot;")

.replace(/'/g,"&#039;");

}


/* CREATE MODAL */

function openCreate(){

editingId = null;


document.getElementById("modalTitle")
.textContent =
"Add product";


document.getElementById("productName")
.value = "";

document.getElementById("sku")
.value = "";

document.getElementById("price")
.value = "";

document.getElementById("wholesale")
.value = "yes";


document.getElementById("overlay")
.style.display = "flex";

}


/* CLOSE MODAL */

function closeModal(){

document.getElementById("overlay")
.style.display = "none";

}


/* EDIT */

function editProduct(id){

const product =
products.find(function(p){

return p.id === id;

});


if(!product){

return;

}


editingId = id;


document.getElementById("modalTitle")
.textContent =
"Edit product";


document.getElementById("productName")
.value =
product.name || "";


document.getElementById("sku")
.value =
product.sku || "";


document.getElementById("price")
.value =
product.price || "";


document.getElementById("wholesale")
.value =
product.wholesale
? "yes"
: "no";


document.getElementById("overlay")
.style.display =
"flex";

}


/* THEME */

function toggleTheme(){

const html =
document.documentElement;

const dark =
html.getAttribute("data-theme")
=== "dark";


if(dark){

html.removeAttribute("data-theme");

localStorage.setItem(
"b2b_theme",
"light"
);

document.getElementById("theme")
.textContent =
"☾";

}else{

html.setAttribute(
"data-theme",
"dark"
);

localStorage.setItem(
"b2b_theme",
"dark"
);

document.getElementById("theme")
.textContent =
"☀";

}

}


/* LOAD THEME */

if(
localStorage.getItem("b2b_theme")
=== "dark"
){

document.documentElement
.setAttribute(
"data-theme",
"dark"
);

document.getElementById("theme")
.textContent =
"☀";

}


/* START */

loadProducts();

</script>

</body>
</html>
